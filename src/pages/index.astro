---
import BaseLayout from "../layouts/BaseLayout.astro";
import LandlordMathLink from "../components/LandlordMathLink.astro";
import { site } from "../data/site";
import { tools } from "../data/tools";
import { guides } from "../data/guides";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: site.url,
    description: site.description
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Rent Estimate and Comps Checker",
    url: site.url,
    description: site.description
  }
];
---

<BaseLayout
  title="Rent Checker | Estimate Rent and Compare Rental Pricing"
  description="Estimate rent, compare rental properties, and analyze whether rent is above or below market using simple rental pricing tools."
  structuredData={structuredData}
>
  <section class="hero-card">
    <div class="eyebrow">Rent estimate and comps checker</div>
    <h1>Estimate Rent Before You List</h1>
    <p class="hero-copy">Use simple rent estimate, rental comparison, and market rent tools to decide what a property should rent for before you list it.</p>
    <p class="hero-copy">Rent Checker helps you estimate, compare, and position rent before pricing a property.</p>
    <div class="hero-actions">
      <a class="button primary-button" href="/rent-estimate/">Start With Rent Estimate</a>
      <a class="button secondary-button" href="/rent-comparison/">Compare Rental Properties</a>
    </div>
  </section>

  <section class="content-card">
    <h2>A Simple Rent Pricing Workflow</h2>
    <div class="workflow-grid">
      <article class="step-card">
        <span class="step-number">1</span>
        <h3>Estimate Rent</h3>
        <p>Start with property details like square footage, bedrooms, bathrooms, property type, and condition.</p>
        <a class="button primary-button" href="/rent-estimate/">Use Rent Estimate Calculator</a>
      </article>
      <article class="step-card">
        <span class="step-number">2</span>
        <h3>Compare Rentals</h3>
        <p>Enter similar rentals side by side to compare rent, square footage, and price per square foot.</p>
        <a class="button primary-button" href="/rent-comparison/">Use Rent Comparison Tool</a>
      </article>
      <article class="step-card">
        <span class="step-number">3</span>
        <h3>Analyze Market Position</h3>
        <p>Check whether your rent is above, below, or within your estimated market range.</p>
        <a class="button primary-button" href="/market-rent-analysis/">Use Market Rent Analysis</a>
      </article>
    </div>
  </section>

  <section class="content-card">
    <h2>Rent Pricing Tools</h2>
    <div class="tool-grid">
      {tools.map((tool) => (
        <a class="tool-card" href={`/${tool.slug}/`}>
          <strong>{tool.pageTitle}</strong>
          <span>{tool.intro}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="content-card">
    <h2>Rent Guides</h2>
    <div class="tool-grid">
      {guides.map((guide) => (
        <a class="tool-card" href={`/guides/${guide.slug}/`}>
          <strong>{guide.pageTitle}</strong>
          <span>{guide.intro}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="content-card">
    <h2>Planning note</h2>
    <p class="disclaimer">This tool provides estimates for planning purposes only and does not replace professional real estate advice.</p>
  </section>

  <LandlordMathLink />
</BaseLayout>
